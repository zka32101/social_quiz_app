  "features": {
    "daily_checkin_streak_tracking": {
      "status": "implemented",
      "test_coverage": "100%",
      "description": "Record daily parent checkins and track streak",
      "methods": [
        "recordDailyCheckin(parentId, timestamp)",
        "getStreakData(parentId)"
      ],
      "providers": [
        "streakDataProvider"
      ]
    },
    "weekly_challenge_generation": {
      "status": "implemented",
      "test_coverage": "100%",
      "description": "Generate personalized challenges based on weak fraud patterns",
      "methods": [
        "generateWeeklyChallenge(parentId, weakFraudPattern)",
        "updateChallengeProgress(parentId, weekNumber, completedQuizzes)"
      ],
      "fraud_patterns": [
        "phishing",
        "fake_news",
        "social_engineering",
        "password_security",
        "payment_fraud"
      ],
      "automation": "Cloud Scheduler (Monday 0:00)"
    },
    "safety_score_calculation": {
      "status": "implemented",
      "test_coverage": "100%",
      "description": "Aggregate AI truth, crime quiz, and safety risk scores",
      "methods": [
        "calculateSafetyScore(parentId)",
        "getSafetyAdvice(safetyScore)"
      ],
      "weighting": {
        "ai_truth_score": 0.30,
        "crime_quiz_score": 0.40,
        "safety_risk_score": 0.30
      },
      "range": "0-100",
      "automation": "Cloud Scheduler (Daily 1:00)"
    },
    "milestone_detection_badges": {
      "status": "implemented",
      "test_coverage": "100%",
      "description": "Detect milestones and award badges automatically",
      "methods": [
        "detectMilestones(parentId, userProgress)",
        "getBadgeDefinitions()"
      ],
      "badge_categories": {
        "streak": 3,
        "safety": 2,
        "engagement": 3,
        "combined": 2
      },
      "total_badges": 10,
      "automation": "Cloud Scheduler (Daily 2:00)"
    },
    "activity_logging": {
      "status": "implemented",
      "test_coverage": "100%",
      "description": "Log activities for risk assessment",
      "methods": [
        "logActivity(parentId, actionType, details, riskLevel)"
      ]
    }
  },
  "firestore_structure": {
    "collections": [
      {
        "path": "parent_engagement",
        "document": "{parentId}",
        "fields": {
          "parentId": "string",
          "lastCheckinDate": "Timestamp",
          "currentStreak": "int",
          "maxStreak": "int",
          "totalCheckins": "int",
          "aiTruthScore": "double",
          "crimeQuizScore": "double",
          "safetyRiskScore": "double",
          "totalSafetyScore": "double",
          "badges": "array<string>",
          "updatedAt": "Timestamp",
          "safetyScoreUpdatedAt": "Timestamp",
          "badgesUpdatedAt": "Timestamp"
        },
        "sub_collections": [
          {
            "name": "weekly_challenges",
            "document": "week_{weekNumber}",
            "fields": {
              "parentId": "string",
              "weekNumber": "int",
              "startDate": "Timestamp",
              "endDate": "Timestamp",
              "fraudPattern": "string",
              "title": "string",
              "difficulty": "string",
              "quizzesCount": "int",
              "reward": "int",
              "completed": "bool",
              "quizzesCompleted": "int",
              "completedAt": "Timestamp|null"
            }
          },
          {
            "name": "activity_logs",
            "document": "{logId}",
            "fields": {
              "timestamp": "Timestamp",
              "actionType": "string",
              "riskLevel": "string",
              "details": "map<string, dynamic>"
            }
          }
        ]
      }
    ]
  },
